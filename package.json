{
  "name": "stillflow.engine",
  "version": "0.7.0",
  "description": "A headless, transaction-based UI engine with AOT compilation.",
  "type": "module",
  "main": "./dist/index.es.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./collections": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./operators": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./vite": {
      "import": "./dist/vite.es.js",
      "require": "./dist/vite.cjs.js",
      "types": "./dist/vite.plugin.d.ts"
    },
    "./vms": {
      "import": "./dist/vms.es.js",
      "require": "./dist/vms.cjs.js",
      "types": "./dist/targets.index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ui",
    "framework",
    "transactional",
    "aot",
    "headless",
    "typescript",
    "dom"
  ],
  "author": "SampleUserD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SampleUserD/Stillflow.Engine.git"
  },
  "bugs": {
    "url": "https://github.com/SampleUserD/Stillflow.Engine/issues"
  },
  "homepage": "https://github.com/SampleUserD/Stillflow.Engine#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "debug": "vite --debug",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.0.0",
    "vite-plugin-dts": "^5.1.2",
    "@babel/core": "^8.1.2",
    "@types/babel__core": "^7.20.5",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@babel/core": "^8.1.2",
    "@types/babel__core": "^7.20.5",
    "vite": "^8.3.8"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "@babel/core": {
      "optional": true
    },
    "@types/babel__core": {
      "optional": true
    }
  }
}
