{
  "name": "stillflow.engine",
  "version": "0.4.6",
  "description": "A headless, transaction-based UI engine with AOT compilation.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vm": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./collection": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./jsx-runtime": {
      "type": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ui",
    "framework",
    "transactional",
    "aot",
    "headless",
    "typescript",
    "dom"
  ],
  "author": "SampleUserD",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SampleUserD/Stillflow.Engine.git"
  },
  "bugs": {
    "url": "https://github.com/SampleUserD/Stillflow.Engine/issues"
  },
  "homepage": "https://github.com/SampleUserD/Stillflow.Engine#readme",
  "scripts": {
    "build": "tsc --build && tsc-alias && tsc-esm-fix",
    "watch": "concurrently \"tsc -w\" \"tsc-alias -w\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsc-alias": "^1.9.10",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.0.0"
  }
}
