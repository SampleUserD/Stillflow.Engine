{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "target": "esnext",
    "module": "es2022",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "declaration": true,
    "declarationDir": "./dist",
    "jsxImportSource": "../",
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@vm/*": [
        "./src/stillflow-vm/*"
      ],
      "@collection/*": [
        "./src/stillflow-collection/*"
      ],
      "@adapters/*": [
        "./src/stillflow-adapters/*"
      ],
      "@core/*": [
        "./src/stillflow/*"
      ]
    }
  }
}